# Configurar el dominio final antes de publicar.
NEXT_PUBLIC_SITE_URL=https://www.ejemplo.com.ar

# Netlify detecta el formulario estático y no necesita esta variable.
# En otros hosts, usar un endpoint que acepte POST application/x-www-form-urlencoded.
# NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=https://ejemplo.com/formulario
